# API key for the skill-eval harness (`uv run pytest tests/`).
OPENROUTER_API_KEY=

# Base URL used when building skill files and inventory links.
# For local development, use your local server address.
# In CI/CD these are derived from the repo (see .github/workflows/deploy.yml).
#
# skills-hub-builder reads these from the *environment*, not from .env, so
# export them or pass --base-url / --repo-url on the command line.
BASE_URL=http://localhost:8765/

# GitHub repo URL for "edit" links on the website.
# Leave empty to hide edit links.
REPO_URL=https://github.com/harvard-lil/lawskills-hub/
